<!--
  Documentation: https://spotbugs.readthedocs.io/en/latest/filter.html
-->
<FindBugsFilter>
    <!-- Exclude rank 16+ ("of concern"). Lower rank is more severe. -->
    <Match>
        <Rank value="16"/>
    </Match>

    <!-- Pre-existing DateFormat statics, Spring writes to statics, lazy cookie init. -->
    <Match>
        <Bug pattern="STCAL_INVOKE_ON_STATIC_DATE_FORMAT_INSTANCE,STCAL_STATIC_SIMPLE_DATE_FORMAT_INSTANCE,ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD,LI_LAZY_INIT_STATIC"/>
    </Match>

    <!-- Pre-existing null-check noise (not introduced by Boot 3.5). -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH,NP_NULL_ON_SOME_PATH_EXCEPTION,RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>

    <!-- SpotBugs false positive: notifyAll is inside synchronized (READY_LOCK). -->
    <Match>
        <Class name="org.ihtsdo.refsetservice.util.PropertyUtility"/>
        <Method name="init"/>
        <Bug pattern="NN_NAKED_NOTIFY"/>
    </Match>
    <Match>
        <Class name="~.*\..*Test.*"/>
        <Not>
            <Bug code="IJU"/>
        </Not>
    </Match>
</FindBugsFilter>
