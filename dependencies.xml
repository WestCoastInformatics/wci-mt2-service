<?xml version="1.0" encoding="UTF-8"?>
<suppressions
	xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

	<!-- Consul/Vault config clients are CPE-matched to spring_cloud_config (Config Server).
	     CVEs below are Config Server issues (monitor webhook, git/svn basedir, native repo, GSM). -->
	<suppress>
		<notes><![CDATA[
		False positive: spring-cloud-consul-config is not Spring Cloud Config Server.
		]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-consul-config@.*$</packageUrl>
		<cpe>cpe:/a:vmware:spring_cloud_config</cpe>
	</suppress>
	<suppress>
		<notes><![CDATA[
		False positive: spring-cloud-starter-consul-config is not Spring Cloud Config Server.
		]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-starter-consul-config@.*$</packageUrl>
		<cpe>cpe:/a:vmware:spring_cloud_config</cpe>
	</suppress>
	<suppress>
		<notes><![CDATA[
		False positive: spring-cloud-starter-vault-config is not Spring Cloud Config Server.
		]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-starter-vault-config@.*$</packageUrl>
		<cpe>cpe:/a:vmware:spring_cloud_config</cpe>
	</suppress>
	<suppress>
		<notes><![CDATA[
		False positive: spring-cloud-vault-config is not Spring Cloud Config Server.
		]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-vault-config@.*$</packageUrl>
		<cpe>cpe:/a:vmware:spring_cloud_config</cpe>
	</suppress>

</suppressions>
